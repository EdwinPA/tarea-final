pipeline {
    //agent any
    agent {
        kubernetes {
            defaultContainer 'node-tool'
            yamlFile 'agent.yaml'
        }
    }
    environment{
        DH_REPO = 'edwinpa/tarea-final'
        GH_REPO = 'ghcr.io/edwinpa/tarea-final'
        GL_REPO = 'registry.gitlab.com/edwinpa/tarea-final/tarea-final'
        K8S_NAMESPACE = 'ns-edwin-pacheco'
    }
    stages{
        stage("CI - Activacion de pnpm"){
            steps{
                sh 'corepack enable'
                sh 'node --version'
                sh 'pnpm --version'
            }
        }
        stage("CI - Instalacion de dependencias"){
            steps{
                sh 'pnpm install --frozen-lockfile'
            }
        }
        stage("CI - Revision de Linter"){
            steps{
                sh 'pnpm lint'
            }
        }
        stage("CI - Ejecucion de Test"){
            steps{
                 sh 'pnpm test'
            }
        }
        stage("CI - Construccion de aplicacion"){
            steps{
                 sh 'pnpm build'
            }
        }
        stage("CD - Construccion imagen y upload"){
            steps{
                container('buildkit'){
                    sh '''
                        export DOCKER_CONFIG=/docker-config/github
                        test -s ${DOCKER_CONFIG}/config.json

                        buildctl-daemonless.sh build \
                        --frontend dockerfile.v0 \
                        --local context=. \
                        --local dockerfile=. \
                        --output type=image,\\\"name=${GH_REPO}:edwin-pacheco,${GH_REPO}:${BUILD_NUMBER}\\\",push=true

                        export DOCKER_CONFIG=/docker-config/gitlab
                        test -s ${DOCKER_CONFIG}/config.json

                        buildctl-daemonless.sh build \
                        --frontend dockerfile.v0 \
                        --local context=. \
                        --local dockerfile=. \
                        --output type=image,\\\"name=${GL_REPO}:edwin-pacheco,${GL_REPO}:${BUILD_NUMBER}\\\",push=true
                    '''
                }
            }
        }
        stage('CD - Despliegue continuo'){
            when {
                anyOf {
                    branch 'main'
                    branch 'test'
                }
            }
            steps{
                container('kubectl-tool'){
                    withKubeConfig([credentialsId: 'kubernetes-config']){
                        sh '''
                           kubectl -n ${K8S_NAMESPACE} set image deployment/app-edwin-pacheco ns-edwin-pacheco=${GH_REPO}:${BUILD_NUMBER}
                           kubectl -n ${K8S_NAMESPACE} rollout status deployment/app-edwin-pacheco
                        '''
                    }
                }
            }
        }
    }
}